{
  "$schema": "https://json.schemastore.org/claude-code-settings",
  "cleanupPeriodDays": 99999,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "statusLine": {
    "type": "command",
    "command": "npx -y @owloops/claude-powerline@1.26.0 --style=powerline --theme=nord"
  },
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff)",
      "Bash(git diff --stat)",
      "Bash(git diff --cached)",
      "Bash(git diff HEAD)",
      "Bash(git diff --name-only:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show --stat:*)",
      "Bash(git show --name-only:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(pwd)",
      "Bash(qmd query:*)",
      "Read(**)",
      "Grep(**)",
      "Glob(**)",
      "Bash(uv:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(pip:*)",
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(mypy:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(nc:*)",
      "Bash(ncat:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(eval:*)",
      "Bash(chmod 777:*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(.ssh/**)",
      "Read(**/.ssh/**)",
      "Write(.env)",
      "Write(.env.*)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Write(.git/**)",
      "Edit(.git/**)",
      "Write(.ssh/**)",
      "Edit(.ssh/**)",
      "Write(.claude/settings.json)",
      "Edit(.claude/settings.json)",
      "Write(.claude/scripts/**)",
      "Edit(.claude/scripts/**)",
      "Write(docs/specs/**)",
      "Edit(docs/specs/**)",
      "Write(.venv/**)",
      "Write(__pycache__/**)",
      "Write(.pytest_cache/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/scripts/session-start.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cp docs/state/hot.md docs/state/hot.md.precompact 2>/dev/null || true"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/scripts/post-compact.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && uv run ruff check . && uv run mypy . && uv run pytest -q --no-header",
            "timeout": 240
          }
        ]
      }
    ]
  }
}
